{
    "i18n": true,
    "type": "tabs",
    "items": {
        "connectionTab": {
            "type": "panel",
            "label": "tab_connection",
            "items": {
                "_intro": {
                    "type": "staticText",
                    "text": "intro_connection",
                    "hidden": "data._expertMode === true",
                    "sm": 12
                },
                "host": {
                    "type": "text",
                    "label": "label_host",
                    "help": "help_host",
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                },
                "port": {
                    "type": "number",
                    "label": "label_port",
                    "help": "help_port",
                    "min": 1,
                    "max": 65535,
                    "default": 8123,
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                },
                "secure": {
                    "type": "checkbox",
                    "label": "label_secure",
                    "help": "help_secure",
                    "sm": 12,
                    "md": 6,
                    "lg": 4
                },
                "accessToken": {
                    "type": "password",
                    "label": "label_access_token",
                    "help": "help_access_token",
                    "repeat": false,
                    "sm": 12,
                    "md": 12,
                    "lg": 12
                },
                "allowSelfSignedCert": {
                    "type": "checkbox",
                    "label": "label_allow_selfsigned",
                    "help": "help_allow_selfsigned",
                    "expertMode": true,
                    "sm": 12,
                    "md": 6,
                    "lg": 6
                },
                "caCertificate": {
                    "type": "text",
                    "label": "label_ca_certificate",
                    "help": "help_ca_certificate",
                    "expertMode": true,
                    "sm": 12,
                    "md": 12,
                    "lg": 12
                },
                "_testConnection": {
                    "type": "sendTo",
                    "label": "btn_test_connection",
                    "command": "testConnection",
                    "jsonData": "{\"host\":\"${data.host}\",\"port\":${data.port},\"secure\":${data.secure},\"accessToken\":\"${data.accessToken}\"}",
                    "variant": "contained",
                    "sm": 12
                }
            }
        },
        "objectsTab": {
            "type": "panel",
            "label": "tab_objects",
            "items": {
                "_intro": {
                    "type": "staticText",
                    "text": "intro_objects",
                    "hidden": "data._expertMode === true",
                    "sm": 12
                },
                "createDevicesTree": {
                    "type": "checkbox",
                    "label": "label_create_devices_tree",
                    "help": "help_create_devices_tree",
                    "default": true,
                    "sm": 12,
                    "md": 6
                },
                "createEntitiesTree": {
                    "type": "checkbox",
                    "label": "label_create_entities_tree",
                    "help": "help_create_entities_tree",
                    "default": false,
                    "sm": 12,
                    "md": 6
                },
                "autoIncludeNewDevices": {
                    "type": "checkbox",
                    "label": "label_auto_include",
                    "help": "help_auto_include",
                    "default": true,
                    "sm": 12,
                    "md": 6
                },
                "debounceMs": {
                    "type": "number",
                    "label": "label_debounce_ms",
                    "help": "help_debounce_ms",
                    "default": 50,
                    "min": 0,
                    "max": 5000,
                    "expertMode": true,
                    "sm": 12,
                    "md": 4
                },
                "writeCoalesceMs": {
                    "type": "number",
                    "label": "label_write_coalesce_ms",
                    "help": "help_write_coalesce_ms",
                    "default": 30,
                    "min": 0,
                    "max": 2000,
                    "expertMode": true,
                    "sm": 12,
                    "md": 4
                },
                "responseTimeoutMs": {
                    "type": "number",
                    "label": "label_response_timeout_ms",
                    "help": "help_response_timeout_ms",
                    "default": 2000,
                    "min": 500,
                    "max": 60000,
                    "expertMode": true,
                    "sm": 12,
                    "md": 4
                }
            }
        },
        "selectionTab": {
            "type": "panel",
            "label": "tab_selection",
            "items": {
                "_intro": {
                    "type": "staticText",
                    "text": "intro_selection",
                    "hidden": "data._expertMode === true",
                    "sm": 12
                },
                "_refresh": {
                    "type": "sendTo",
                    "label": "btn_refresh_selection",
                    "command": "refreshSelection",
                    "variant": "outlined",
                    "sm": 12,
                    "md": 6
                },
                "syncDevicesTable": {
                    "type": "table",
                    "label": "label_devices_table",
                    "sm": 12,
                    "items": [
                        {
                            "type": "text",
                            "attr": "deviceId",
                            "title": "Device-ID",
                            "width": "250px"
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Name",
                            "width": "200px"
                        },
                        {
                            "type": "text",
                            "attr": "manufacturer",
                            "title": "Hersteller",
                            "width": "120px"
                        },
                        {
                            "type": "text",
                            "attr": "model",
                            "title": "Modell",
                            "width": "120px"
                        },
                        {
                            "type": "number",
                            "attr": "entityCount",
                            "title": "#Ent",
                            "width": "70px"
                        },
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Sync",
                            "width": "60px"
                        }
                    ],
                    "noDelete": true,
                    "noAdd": true
                },
                "syncEntitiesTable": {
                    "type": "table",
                    "label": "label_entities_table",
                    "expertMode": true,
                    "sm": 12,
                    "items": [
                        {
                            "type": "text",
                            "attr": "entityId",
                            "title": "Entity-ID",
                            "width": "300px"
                        },
                        {
                            "type": "text",
                            "attr": "domain",
                            "title": "Domain",
                            "width": "120px"
                        },
                        {
                            "type": "text",
                            "attr": "deviceId",
                            "title": "Device",
                            "width": "250px"
                        },
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Sync",
                            "width": "60px"
                        }
                    ],
                    "noDelete": true,
                    "noAdd": true
                }
            }
        },
        "assignmentTab": {
            "type": "panel",
            "label": "tab_assignment",
            "items": {
                "_intro": {
                    "type": "staticText",
                    "text": "intro_assignment",
                    "hidden": "data._expertMode === true",
                    "sm": 12
                },
                "_refresh": {
                    "type": "sendTo",
                    "label": "btn_refresh_selection",
                    "command": "refreshSelection",
                    "variant": "outlined",
                    "sm": 12,
                    "md": 6
                },
                "assignmentsTable": {
                    "type": "table",
                    "label": "label_assignments_table",
                    "sm": 12,
                    "items": [
                        {
                            "type": "text",
                            "attr": "deviceId",
                            "title": "Device-ID",
                            "width": "250px"
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Name",
                            "width": "200px"
                        },
                        {
                            "type": "text",
                            "attr": "hassArea",
                            "title": "HASS-Area",
                            "width": "140px"
                        },
                        {
                            "type": "selectSendTo",
                            "attr": "room",
                            "title": "ioBroker-Raum",
                            "width": "200px",
                            "command": "listRooms"
                        },
                        {
                            "type": "selectSendTo",
                            "attr": "function",
                            "title": "Funktion",
                            "width": "200px",
                            "command": "listFunctions"
                        }
                    ],
                    "noDelete": true,
                    "noAdd": true
                }
            }
        },
        "mappingTab": {
            "type": "panel",
            "label": "tab_mapping",
            "items": {
                "_intro": {
                    "type": "staticText",
                    "text": "intro_mapping",
                    "hidden": "data._expertMode === true",
                    "sm": 12
                },
                "_refresh": {
                    "type": "sendTo",
                    "label": "btn_refresh_selection",
                    "command": "refreshSelection",
                    "variant": "outlined",
                    "sm": 12,
                    "md": 6
                },
                "customMappingsTable": {
                    "type": "table",
                    "label": "label_mapping_table",
                    "sm": 12,
                    "items": [
                        {
                            "type": "text",
                            "attr": "entityId",
                            "title": "Entity-ID",
                            "width": "320px"
                        },
                        {
                            "type": "select",
                            "attr": "overrideType",
                            "title": "Type-Override",
                            "width": "180px",
                            "options": [
                                {
                                    "value": "none",
                                    "label": "(skip)"
                                },
                                {
                                    "value": "light",
                                    "label": "light"
                                },
                                {
                                    "value": "dimmer",
                                    "label": "dimmer"
                                },
                                {
                                    "value": "rgb",
                                    "label": "rgb"
                                },
                                {
                                    "value": "socket",
                                    "label": "socket"
                                },
                                {
                                    "value": "thermostat",
                                    "label": "thermostat"
                                },
                                {
                                    "value": "blind",
                                    "label": "blind"
                                },
                                {
                                    "value": "window",
                                    "label": "window"
                                },
                                {
                                    "value": "door",
                                    "label": "door"
                                },
                                {
                                    "value": "motion",
                                    "label": "motion"
                                },
                                {
                                    "value": "temperature",
                                    "label": "temperature"
                                },
                                {
                                    "value": "humidity",
                                    "label": "humidity"
                                },
                                {
                                    "value": "media",
                                    "label": "media"
                                },
                                {
                                    "value": "vacuum",
                                    "label": "vacuum"
                                },
                                {
                                    "value": "lock",
                                    "label": "lock"
                                },
                                {
                                    "value": "button",
                                    "label": "button"
                                }
                            ]
                        }
                    ],
                    "noDelete": true,
                    "noAdd": true
                }
            }
        },
        "diagnosticsTab": {
            "type": "panel",
            "label": "tab_diagnostics",
            "items": {
                "_intro": {
                    "type": "staticText",
                    "text": "intro_diagnostics",
                    "hidden": "data._expertMode === true",
                    "sm": 12
                },
                "_forceSync": {
                    "type": "sendTo",
                    "label": "btn_force_sync",
                    "command": "forceSync",
                    "variant": "outlined",
                    "sm": 12,
                    "md": 6
                }
            }
        }
    }
}